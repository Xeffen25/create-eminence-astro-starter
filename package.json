{
  "name": "create-eminence-astro-starter",
  "version": "0.0.0",
  "description": "Create a minimal Astro project deployed to Cloudflare Workers.",
  "type": "module",
  "bin": {
    "create-eminence-astro-starter": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "changeset": "changeset",
    "create-project": "tsx src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "pnpm build && pnpm test && pnpm publish",
    "test": "vitest run",
    "version": "changeset version"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "execa": "^10.0.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
